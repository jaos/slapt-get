msgstr "Debian'ın APT sisteminin Slackware'e uygulanması\n"

#, c-format
msgid "Usage:\n"
msgstr "Kullanım:\n"

#, c-format
msgid "%s [option(s)] [target]\n"
msgstr "%s [seçenek(ler)] [hedef]\n"

#, c-format
msgid "Targets:\n"
msgstr "Hedefler:\n"

